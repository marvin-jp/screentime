<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replace __HOME__ with your home directory, then install to
         ~/Library/LaunchAgents/com.screentime.plist and run:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.screentime.plist
         mac/install-notes.md has the full sequence. -->
    <key>Label</key>
    <string>com.screentime</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Screentime.app/Contents/MacOS/screentime</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/screentime.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/screentime.log</string>
</dict>
</plist>
